# .dockerignore — place this in the project root alongside docker-compose.yml

# Virtual environment
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs (generated at runtime, not needed in image)
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Secrets — never bake these into the image
.env